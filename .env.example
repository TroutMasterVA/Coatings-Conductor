# Coatings Conductor — environment variables.
#
# Copy to `.env` (never commit it) and fill in real values on the host.
# Every value below is a PLACEHOLDER. Do not put real keys or passwords in git.

# ---------------------------------------------------------------------------
# Database (required for real use)
# ---------------------------------------------------------------------------
# REQUIRED for any real or shared deploy (Docker / PAVE and Vercel).
# Postgres connection string. If unset, the app falls back to an embedded
# in-memory database: every account, job and record is wiped on restart and is
# different on each server instance (people get signed out, then "Invalid email
# or password"). Only for local development, CI and throwaway previews.
# A fresh database needs the migrations applied BEFORE the first sign-up:
#   npm run db:migrate      (applies every migrations/*.sql not yet applied)
# The Docker image runs this at container start (see RUN_MIGRATIONS below).
# On Vercel the build runs it when DATABASE_URL is set at build time.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/coatings_conductor?sslmode=require

# ---------------------------------------------------------------------------
# Sign-in (Better Auth, email + password)
# ---------------------------------------------------------------------------
# REQUIRED for any real or shared deploy (Docker / PAVE and Vercel).
# Random value of at least 32 bytes that signs sign-in sessions. Generate one:
#   openssl rand -base64 32
# Without it each server instance invents its own and people get signed out.
# Keep it stable; changing it signs everyone out. Store it as a secret.
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# The public HTTPS address people use to open the app (no trailing slash).
BETTER_AUTH_URL=https://coatings.example.com
# Leave "true" so email/password sign-in is enforced. "false" = shared dev user
# with no sign-in (local development only). Read at build time AND run time.
VITE_AUTH_ENABLED=true

# ---------------------------------------------------------------------------
# Server (container)
# ---------------------------------------------------------------------------
# Port the server listens on inside the container (default 3000).
PORT=3000
# Optional version label shown by /api/health (the Docker build sets it from
# --build-arg APP_VERSION).
# APP_VERSION=
# Set to "false" if migrations are run by a separate job instead of at start.
# RUN_MIGRATIONS=true

# Largest sheet upload accepted, in megabytes. Default 10 (container / PAVE).
# On the Vercel practice copy set it to 3: Vercel caps request bodies at ~4.5 MB.
MAX_UPLOAD_MB=10

# Client IP for the per-IP rate limits. PAVE: set these from IT's answer.
# TRUSTED_PROXY_HOPS = how many trusted proxies append to X-Forwarded-For; the client IP is
# read that many entries from the right. Default 1 (right for the Vercel practice copy).
# TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER = a header the ingress sets itself and strips from clients (optional).
# CLIENT_IP_HEADER=

# ---------------------------------------------------------------------------
# Azure AI Foundry — sheet reader (optional; company IT fills these in)
# ---------------------------------------------------------------------------
# When the four AZURE_* settings marked [required for Azure] are all set,
# Azure is the primary sheet reader. If any is missing, or Azure fails, the app
# uses the built-in on-device reader instead.
#
# Sign-in to Azure uses the app's managed identity (DefaultAzureCredential)
# first. The *_KEY / *_API_KEY values are an optional fallback only — prefer
# managed identity and leave them empty.

# [required for Azure] Document Intelligence endpoint
AZURE_DOCINTEL_ENDPOINT=https://YOUR-DOCINTEL-RESOURCE.cognitiveservices.azure.com/
# Document Intelligence model (leave as prebuilt-layout)
AZURE_DOCINTEL_MODEL=prebuilt-layout
# [required for Azure] Azure OpenAI / Foundry endpoint
AZURE_OPENAI_ENDPOINT=https://YOUR-OPENAI-RESOURCE.openai.azure.com/
# [required for Azure] Name of the vision-capable (GPT-4o class) deployment
AZURE_OPENAI_DEPLOYMENT=your-gpt-4o-deployment-name
# [required for Azure] API version that supports json_schema output + images
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional key fallback (only if managed identity is not available)
AZURE_DOCINTEL_KEY=
AZURE_OPENAI_API_KEY=
